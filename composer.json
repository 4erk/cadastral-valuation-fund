{
    "name": "rosreestr/cadastral",
    "description": "PHP 8.2+ client for NSPD cadastral valuation history, current value and documents",
    "license": "proprietary",
    "authors": [
        {
            "name": "4erk",
            "email": "mr4erk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "guzzlehttp/guzzle": "^7.9.2",
        "yiisoft/hydrator": "^1.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.38"
    },
    "autoload": {
        "psr-4": {
            "Rosreestr\\Cadastral\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rosreestr\\Cadastral\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "type": "library"
}
